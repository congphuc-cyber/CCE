# ==============================================================================
# Biến môi trường mẫu cho Hệ thống Quản lý Đào tạo CCE (ĐH Bách Khoa)
# Sao chép file này thành .env để tùy chỉnh nếu cần: cp .env.example .env
# ==============================================================================

# Khóa bí mật Django (Trong môi trường dev có giá trị mặc định, production bắt buộc phải đặt)
DJANGO_SECRET_KEY=cce-local-dev-insecure-secret-key-replace-in-production-2026

# Môi trường chạy: development hoặc production
DJANGO_ENV=development

# Danh sách host cho phép truy cập (ngăn cách bởi dấu phẩy)
ALLOWED_HOSTS=127.0.0.1,localhost

# Cổng khởi chạy mặc định
PORT=8001

# Tài khoản Quản trị viên khởi tạo mặc định (dùng khi chạy lệnh bootstrap)
BOOTSTRAP_SUPERUSER_USERNAME=cce_admin
BOOTSTRAP_SUPERUSER_PASSWORD=CCEtest@2026!
BOOTSTRAP_SUPERUSER_EMAIL=admin@cce.edu.vn
